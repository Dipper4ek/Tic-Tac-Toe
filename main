map = [" ", " ", " ",
       " ", " ", " ",
       " ", " ", " ",]
def main():
    print("[", map[0], "]", "[", map[1], "]", "[", map[2], "]")
    print("[", map[3], "]", "[", map[4], "]", "[", map[5], "]")
    print("[", map[6], "]", "[", map[7], "]", "[", map[8], "]\n")

    print("\n[", "1", "]", "[", "2", "]", "[", "3", "]")
    print("[", "4", "]", "[", "5", "]", "[", "6", "]")
    print("[", "7", "]", "[", "8", "]", "[", "9", "]")

    a = int(input())
    for i in range(len(map)):
        map[a-1] = "x"



while True:
    main()
